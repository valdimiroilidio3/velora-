# VELORA — modelo de configuração.
# ============================================================================
# Copiar para `.env.local` (não commitizado) e preencher com valores LOCAIS.
#
# Regras:
#   - Nunca colocar segredos reais neste ficheiro.
#   - Nunca commitizar `.env.local`, `.env.production`, chaves de serviço ou tokens.
#   - Em produção as variáveis são definidas no host de alojamento, nunca no repositório.
#   - O bloco ATIVO é validado por `src/lib/env.ts`. Um teste unitário garante que
#     `.env.example` e o schema não divergem (docs/QUALITY-GATES.md).
# ============================================================================

# --- BLOCO ATIVO (Fase 0) — validado pela aplicação --------------------------

# Ambiente Node (development | test | production). Definido automaticamente pelo Next.js.
NODE_ENV=development
# Porta do servidor local.
PORT=3000
# Origem pública canónica (usada em URLs absolutos, partilhas e previews).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Rótulo do ambiente apresentado na interface.
NEXT_PUBLIC_APP_ENV=development

# Identidade do build — preenchida pelo CI/CD; deixar vazia em desenvolvimento local.
NEXT_PUBLIC_GIT_SHA=
NEXT_PUBLIC_BUILD_TIMESTAMP=

# Base de dados. Na Fase 0 a aplicação NÃO abre ligações; a variável é opcional.
# Usar uma base de dados dedicada, nunca partilhada.
DATABASE_URL=postgresql://postgres:***@localhost:5432/velora_dev
# Nº máximo de ligações no pool do servidor de aplicação.
DATABASE_POOL_MAX=5
# Tempo (ms) para terminar uma ligação inativa.
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Sessão. `AUTH_SECRET` é obrigatória em produção — gerar por ambiente com:
#   openssl rand -base64 32
AUTH_SECRET=
# URL base da aplicação para callbacks de autenticação.
AUTH_URL=http://localhost:3000
# Sessão inativa, em horas.
SESSION_IDLE_TTL_HOURS=12

# Limites de pedidos (antiabuso).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Limites de IA. Na Fase 0 nenhum provedor é contactado.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_MAX_REQUESTS_PER_MINUTE=10
AI_MAX_UPLOAD_MB=25

# Telemetria do próprio framework (1 = desativada; reavaliar com observabilidade).
NEXT_TELEMETRY_DISABLED=1

# --- BLOCO RESERVADO — fases futuras, ainda sem leitura nem validação --------
# ============================================================================
# Nada abaixo deste marcador é lido pelo código na Fase 0. Estas chaves ficam
# documentadas antecipadamente para suportar o plano de custos, mas só são validadas quando
# o módulo correspondente for implementado.
# ============================================================================

# Armazenamento de ficheiros (Fase 2+). Usar prefixo de chave por ambiente em produção.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Observabilidade de erros (Fase 4+). O DSN contém identificação do projeto: tratar como sensível.
SENTRY_DSN=

# E-mail transacional (Fase 2+). Domínio de exemplo não utilizável de propósito.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=VELORA <not-respond@example.invalid>
