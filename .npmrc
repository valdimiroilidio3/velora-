# Configuração de gestão de pacotes do VELORA.
# Nota: as políticas de build scripts de dependências vivem em `package.json` → `pnpm.onlyBuiltDependencies`.

# Versões exatas no package.json; a resolução exata e a integridade ficam no pnpm-lock.yaml.
save-exact=true

# A auditoria de segurança é um gate explícito (`pnpm audit`), não um efeito colateral do install.
audit=false
fund=false
